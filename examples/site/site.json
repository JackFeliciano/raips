{
  "name": "example-site",
  "base": "/",
  "lang": "en",
  "pages": [
    {
      "route": "/",
      "title": "Cobalt Studio",
      "description": "A small studio that builds and hosts sites.",
      "sections": [
        {
          "type": "header",
          "props": {
            "brand": "Cobalt Studio",
            "cta": { "label": "Write to us", "href": "/contact/" },
            "links": [
              { "label": "Work", "href": "/#work" },
              { "label": "Writing", "href": "/writing/" }
            ]
          }
        },
        {
          "type": "hero",
          "props": {
            "eyebrow": "Studio",
            "heading": "Sites that stay up",
            "subheading": "We build the page, host it and keep it answering.",
            "cta": { "label": "See the work", "href": "/#work" }
          }
        },
        {
          "type": "features",
          "props": {
            "heading": "What you get",
            "items": [
              { "title": "A page built from sections", "text": "Pick the sections you want and the builder writes the files." },
              { "title": "A preview before anything goes out", "text": "Look at the site on your own machine first." },
              { "title": "A publish you can undo", "text": "Every publish lands under an id the host answers back." }
            ]
          }
        },
        {
          "type": "gallery",
          "props": {
            "heading": "Work",
            "items": [
              { "src": "assets/one.png", "alt": "A landing page", "caption": "Landing page" },
              { "src": "assets/two.png", "alt": "A services page", "caption": "Services page" }
            ]
          }
        },
        {
          "type": "faq",
          "props": {
            "heading": "Questions",
            "items": [
              { "question": "Where does the site live?", "answer": "Wherever you point the host driver at." },
              { "question": "Can I keep the files?", "answer": "Yes. A build writes plain files you can copy." }
            ]
          }
        },
        {
          "type": "contact",
          "props": {
            "heading": "Say hello",
            "text": "One address, and a person answers it.",
            "href": "mailto:hello@example.com",
            "cta": "Send a note"
          }
        },
        {
          "type": "footer",
          "props": {
            "text": "Cobalt Studio, 2026.",
            "links": [
              { "label": "Writing", "href": "/writing/" },
              { "label": "Contact", "href": "/contact/" }
            ]
          }
        }
      ]
    },
    {
      "route": "/writing/",
      "title": "Writing, Cobalt Studio",
      "sections": [
        { "type": "header", "props": { "brand": "Cobalt Studio" } },
        {
          "type": "blog",
          "props": {
            "heading": "Writing",
            "posts": [
              { "title": "A build you can read", "date": "2026-10-01", "text": "Plain files, one folder, one stylesheet." },
              { "title": "Why the preview matters", "date": "2026-09-14", "text": "A member looks at the page before it costs anything." }
            ]
          }
        },
        { "type": "footer", "props": { "text": "Cobalt Studio, 2026." } }
      ]
    },
    {
      "route": "/contact/",
      "title": "Contact, Cobalt Studio",
