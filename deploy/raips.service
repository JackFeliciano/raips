[Unit]
Description=raips showroom
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/srv/raips
Environment=RAIPS_SITE=/srv/raips/showroom
Environment=RAIPS_DATA=/var/lib/raips
Environment=RAIPS_BASE=/raips/
ExecStart=/usr/bin/php -S 127.0.0.1:8093 -t showroom showroom/index.php
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/raips

[Install]
WantedBy=multi-user.target
